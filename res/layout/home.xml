<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backdrop_placeholder"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:background="@color/backdrop_placeholder"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/backdrop_fade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="invisible" />

    <View
        android:id="@+id/backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:background="@drawable/scrim_bottom"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/backdrop_scrim_top"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@drawable/scrim_top"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp">

        <TextView
            android:id="@+id/cover"
            style="@style/HeroAction"
            android:layout_marginBottom="16dp"
            android:background="@drawable/cover_chip"
            android:nextFocusDown="@id/settings"
            android:nextFocusLeft="@id/cover"
            android:nextFocusRight="@id/cover"
            android:nextFocusUp="@id/cover"
            android:text="Turn on Home cover"
            android:visibility="gone" />

        <TextView
            android:id="@+id/show_title"
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:includeFontPadding="false"
            android:letterSpacing="-0.012"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="10"
            android:textColor="#FFFFFFFF"
            android:textFontWeight="500"
            android:textSize="40sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/show_meta"
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/show_year"
                style="@style/HeroMeta"
                android:layout_marginEnd="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/show_rating"
                style="@style/HeroMeta"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/show_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/imdb_badge"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="IMDb"
                android:textColor="#FF000000"
                android:textFontWeight="500"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/show_genres"
                style="@style/HeroMeta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/show_overview"
            style="@style/HeroMeta"
            android:layout_width="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/trailer"
                style="@style/HeroAction"
                android:nextFocusDown="@+id/hero_prev"
                android:nextFocusLeft="@id/trailer"
                android:nextFocusRight="@id/watch"
                android:nextFocusUp="@id/settings"
                android:text="Trailer"
                android:visibility="gone" />

            <TextView
                android:id="@+id/watch"
                style="@style/HeroAction"
                android:layout_marginEnd="0dp"
                android:nextFocusDown="@+id/hero_prev"
                android:nextFocusLeft="@id/trailer"
                android:nextFocusRight="@id/watch"
                android:nextFocusUp="@id/settings"
                android:text="Watch"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:paddingTop="28dp"
        android:paddingEnd="36dp">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFF"
            android:textFontWeight="500"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/store"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/top_button"
            android:contentDescription="Play Store"
            android:focusable="true"
            android:nextFocusLeft="@id/store"
            android:nextFocusRight="@id/settings"
            android:nextFocusUp="@id/store"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/shop"
            android:tint="@color/top_glyph" />

        <ImageView
            android:id="@+id/settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/top_button"
            android:contentDescription="Settings"
            android:focusable="true"
            android:nextFocusLeft="@id/store"
            android:nextFocusRight="@id/settings"
            android:nextFocusUp="@id/settings"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/gear"
            android:tint="@color/top_glyph" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/dock_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="48dp">

        <dev.litehome.DockScroller
            android:id="@+id/scroller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:fillViewport="false"
            android:focusable="false"
            android:overScrollMode="never"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </dev.litehome.DockScroller>

        <TextView
            android:id="@+id/focus_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:clickable="false"
            android:ellipsize="end"
            android:focusable="false"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textFontWeight="500"
            android:textSize="16sp"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/transport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="168dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/transport_unit"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:defaultFocusHighlightEnabled="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingTop="1dp"
        android:paddingEnd="2dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hero_prev"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:alpha="0.92"
            android:clickable="true"
            android:contentDescription="Previous title"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:nextFocusLeft="@id/hero_prev"
            android:nextFocusRight="@id/hero_prev"
            android:nextFocusUp="@id/watch"
            android:text="‹"
            android:textColor="#FFFFFFFF"
            android:textFontWeight="500"
            android:textSize="13sp" />

        <dev.litehome.ProgressRing
            android:id="@+id/hero_ring"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/hero_next"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:alpha="0.92"
            android:clickable="true"
            android:contentDescription="Next title"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:nextFocusLeft="@id/hero_next"
            android:nextFocusRight="@id/hero_next"
            android:nextFocusUp="@id/watch"
            android:text="›"
            android:textColor="#FFFFFFFF"
            android:textFontWeight="500"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/menu"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:textFontWeight="500"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/action_reorder"
                style="@style/MenuAction"
                android:text="Reorder" />

            <TextView
                android:id="@+id/action_info"
                style="@style/MenuAction"
                android:text="Settings" />

            <TextView
                android:id="@+id/action_quit"
                style="@style/MenuAction"
                android:text="Quit" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
